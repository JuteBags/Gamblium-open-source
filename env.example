# Keys Gamblium's build and release steps use. Copy to `.env` (which git
# ignores) and fill in; in GitHub Actions the same names are repository
# secrets. Never commit the filled-in file.

# The private key that fixes the extension's id (pbgbdlkcienglhbfadbjolphinilbpia).
# A path to the .pem file, kept outside the repository.
GAMBLIUM_EXTENSION_KEY_FILE=

# Code signing of gamblium.exe, gamblium-dl.exe and gamblium-app.exe, so
# Windows shows a publisher instead of "Unknown publisher". Needs a
# code-signing certificate from a certificate authority; none exists yet.
GAMBLIUM_SIGN_CERT_FILE=
GAMBLIUM_SIGN_CERT_PASSWORD=

# NOT here, on purpose: the key that seals a download's login cookie
# (crates/gamblium/src/vault.rs). It is made on each machine at first use and
# wrapped by Windows for that user account. A key from this file would be the
# same on every installation and could be read out of the program, so anyone
# with a copy of Gamblium could open everyone's stored logins.
