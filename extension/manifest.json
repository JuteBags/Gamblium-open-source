{
  "manifest_version": 3,
  "name": "Gamblium",
  "version": "1.0.0",
  "description": "Freezes hidden tabs, takes over big downloads (it reads site cookies for logged-in ones) and adds Gamblium's menu and pages.",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": ["tabs", "alarms", "storage", "downloads", "webRequest", "system.memory", "tabGroups", "scripting", "nativeMessaging", "contextMenus", "webNavigation", "proxy", "unlimitedStorage", "topSites", "search", "favicon", "sidePanel", "debugger", "history", "bookmarks", "sessions", "contentSettings", "cookies", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["*://*/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "ui/icons/icon-16.png", "32": "ui/icons/icon-32.png", "48": "ui/icons/icon-48.png", "128": "ui/icons/icon-128.png" },
  "chrome_url_overrides": { "newtab": "newtab/index.html" },
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+G" }, "description": "Open the Gamblium panel" }, "focus-tab": { "description": "Focus on this tab, or leave focus" }, "space-next": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Go to the next space" } },
  "action": { "default_title": "Gamblium menu", "default_popup": "popup.html", "default_icon": { "16": "ui/icons/menu-light-16.png", "32": "ui/icons/menu-light-32.png" } }
}
